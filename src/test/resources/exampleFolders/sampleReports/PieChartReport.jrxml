								<hyperlinkTooltipExpression><![CDATA["Read more about " + $F{ShipCountry}]]></hyperlinkTooltipExpression>
							</sectionHyperlink>
						</series>
					</dataset>
					<plot labelFormat="{0} {2}" legendLabelFormat="{0} {1}">
						<itemLabel color="#000000" backgroundColor="#FFFFFF"/>
