					<dataset kind="timeSeries" incrementType="Group" resetGroup="CountryGroup" incrementGroup="MonthGroup" timePeriod="Month" resetType="Group">
						<series>
							<seriesExpression><![CDATA["Half Freight"]]></seriesExpression>
