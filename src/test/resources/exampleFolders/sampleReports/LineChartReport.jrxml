	<parameter name="ReportTitle" class="java.lang.String"/>
	<parameter name="MaxOrderID" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT * FROM Orders WHERE OrderID <= $P{MaxOrderID} ORDER BY ShipCountry]]></query>
