<jasperReport name="QueryReport" language="java" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="50" bottomMargin="50" uuid="0c48684c-7768-490c-9f31-e55ee531d12a">
	<template><![CDATA["ReportStyles.jrtx"]]></template>
	<parameter name="ReportTitle" class="java.lang.String"/>
	<parameter name="ExcludedCities" class="java.util.Collection"/>
	<parameter name="OrderClause" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT * FROM Address WHERE $X{NOTIN, City, ExcludedCities} ORDER BY $P!{OrderClause}]]></query>
	<field name="Id" class="java.lang.Integer"/>
	<field name="FirstName" class="java.lang.String"/>
	<field name="LastName" class="java.lang.String"/>
	<field name="Street" class="java.lang.String"/>
	<field name="City" class="java.lang.String"/>
	<variable name="CityNumber" resetType="Group" calculation="System" resetGroup="CityGroup" class="java.lang.Integer">
		<initialValueExpression><![CDATA[($V{CityNumber} != null)?(Integer.valueOf($V{CityNumber}.intValue() + 1)):(Integer.valueOf(1))]]></initialValueExpression>
	</variable>
	<group name="CityGroup" minHeightToStartNewPage="60">
		<expression><![CDATA[$F{City}]]></expression>
		<groupHeader>
			<band height="20">
				<element kind="textField" uuid="e12f660e-a094-4307-ada9-47ae3d333574" mode="Opaque" x="0" y="4" width="515" height="16" backcolor="#C0C0C0" hTextAlign="Left" style="Sans_Bold">
					<expression><![CDATA["  " + String.valueOf($V{CityNumber}) + ". " + String.valueOf($F{City})]]></expression>
					<box style="Sans_Bold">
						<bottomPen lineWidth="1.0"/>
					</box>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="20">
				<element kind="line" uuid="b6ecec36-61ff-463b-ad7b-6c5fd522b5a9" x="0" y="-1" width="515" height="1"/>
				<element kind="staticText" uuid="78bf665f-ab5f-430a-a0a0-1b5e4f808758" x="400" y="0" width="60" height="15" hTextAlign="Right" style="Sans_Bold">
					<paragraph lineSpacing="Single" style="Sans_Bold"/>
					<text><![CDATA[Count : ]]></text>
				</element>
				<element kind="textField" uuid="d6d3a3c2-b5fe-4156-9500-41ce1df06993" x="460" y="0" width="30" height="15" hTextAlign="Right" style="Sans_Bold">
					<paragraph lineSpacing="Single" style="Sans_Bold"/>
					<expression><![CDATA[$V{CityGroup_COUNT}]]></expression>
				</element>
			</band>
		</groupFooter>
	</group>
	<background height="742">
		<element kind="image" uuid="aa0bfad2-717c-47da-85a2-64de9d2b71be" x="0" y="0" width="150" height="742" scaleImage="Clip" hImageAlign="Left" vImageAlign="Bottom">
			<expression><![CDATA["jr.watermark.gif"]]></expression>
		</element>
	</background>
	<title height="50">
		<element kind="line" uuid="11444913-0fe3-4bf4-b016-435a4d574240" x="0" y="0" width="515" height="1" forecolor="#000000"/>
		<element kind="textField" uuid="34f71850-289a-45d4-a938-351b0e370b34" x="0" y="10" width="515" height="30" fontSize="22.0" blankWhenNull="true" hTextAlign="Center" style="Sans_Normal">
			<paragraph lineSpacing="Single" style="Sans_Normal"/>
			<expression><![CDATA[$P{ReportTitle}]]></expression>
		</element>
	</title>
	<pageHeader height="20">
		<element kind="staticText" uuid="2f25e9f3-0cea-4134-a66e-45ccab714369" mode="Opaque" x="0" y="5" width="55" height="15" forecolor="#FFFFFF" backcolor="#333333" hTextAlign="Center" style="Sans_Bold">
			<text><![CDATA[ID]]></text>
		</element>
		<element kind="staticText" uuid="6b4ffe83-d4e5-43d7-a1f1-8e6765fedb72" mode="Opaque" x="55" y="5" width="205" height="15" forecolor="#FFFFFF" backcolor="#333333" style="Sans_Bold">
			<text><![CDATA[Name]]></text>
		</element>
		<element kind="staticText" uuid="6581a183-c344-47fc-ad99-c143e57f5d1e" mode="Opaque" x="260" y="5" width="255" height="15" forecolor="#FFFFFF" backcolor="#333333" style="Sans_Bold">
			<text><![CDATA[Street]]></text>
		</element>
	</pageHeader>
	<detail>
		<band height="20">
			<element kind="textField" uuid="f7cb3744-0d82-4dd1-aeb6-292eac0cfcbe" x="0" y="4" width="50" height="15" hTextAlign="Right">
				<expression><![CDATA[$F{Id}]]></expression>
			</element>
			<element kind="textField" uuid="c55c42b8-6173-4593-91e5-ee62ea1575c8" positionType="Float" x="55" y="4" width="200" height="15" textAdjust="StretchHeight">
