			</element>
			<element kind="line" uuid="f1dfaf3f-22f5-4ac3-ab51-229a53a4481c" positionType="Float" x="0" y="19" width="515" height="1" forecolor="#808080"/>
		</band>
	</detail>
	<pageFooter height="40">
		<printWhenExpression><![CDATA[$P{IS_IGNORE_PAGINATION}.booleanValue()?Boolean.FALSE:Boolean.TRUE]]></printWhenExpression>
