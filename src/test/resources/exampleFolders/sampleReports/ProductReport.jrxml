				</element>
				<element kind="textField" uuid="fab0202d-26d8-439d-b103-d87f12d4fa77" positionType="Float" x="105" y="2" width="20" height="10" textAdjust="StretchHeight" evaluationTime="Group" pattern="#0" evaluationGroup="ProductGroup" hTextAlign="Right">
					<expression><![CDATA[$V{QuantityProductSum}]]></expression>
