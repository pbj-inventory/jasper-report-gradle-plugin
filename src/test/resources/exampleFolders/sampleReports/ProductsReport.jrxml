<jasperReport name="ProductsReport" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" uuid="0e00da16-00fd-4f37-be0d-58fe979c4fd7">
