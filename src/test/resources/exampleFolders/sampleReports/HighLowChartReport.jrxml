				<element kind="textField" uuid="d1828ae8-e125-41f3-ba79-c58bff40267b" x="170" y="2" width="100" height="11" evaluationTime="Group" pattern="EEE, MMM d, yyyy" evaluationGroup="CountryGroup" hTextAlign="Right" style="Sans_Bold">
