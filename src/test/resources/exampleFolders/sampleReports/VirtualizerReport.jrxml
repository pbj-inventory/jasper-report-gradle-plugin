	<variable name="Value" class="java.lang.Double">
		<expression><![CDATA[new Double(500 + 500 * Math.sin($V{REPORT_COUNT}.doubleValue() * Math.log(1 + $V{REPORT_COUNT}.doubleValue())))]]></expression>
	</variable>
	<title height="30">
