		<element kind="textField" uuid="30978da5-7d23-4b53-a9c7-538aa24c6e33" mode="Opaque" x="0" y="650" width="555" height="20" forecolor="#0000FF" backcolor="#FFFF00" markup="styled" textAdjust="StretchHeight" hTextAlign="Center">
