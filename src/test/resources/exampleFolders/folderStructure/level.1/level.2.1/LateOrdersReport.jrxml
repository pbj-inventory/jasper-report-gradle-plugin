			<text><![CDATA[Late deliveries summary (count and total delay) by country and freight range]]></text>
		</element>
		<element kind="crosstab" uuid="6dac4ebd-8eda-4816-b211-33a0df1ea81c" x="0" y="40" width="555" height="60" repeatColumnHeaders="false">
			<dataset>
				<incrementWhenExpression><![CDATA[$V{DeliveryDelay} == null ? Boolean.FALSE : Boolean.TRUE]]></incrementWhenExpression>
			</dataset>
			<rowGroup name="CountryRow" totalPosition="End" width="80">
				<bucket class="java.lang.String">
					<expression><![CDATA[$F{ShipCountry}]]></expression>
				</bucket>
				<header style="CellStyle">
					<element kind="textField" uuid="eae2b604-7382-4f62-a2a0-c62c39463708" x="5" y="0" width="75" height="20" vTextAlign="Middle" style="Sans_Bold">
